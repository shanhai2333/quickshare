#!/bin/sh /etc/rc.common
# QuickShare —— OpenWrt 开机自启（procd）
#
# 装（在路由器上以 root 执行，或者在电脑上 scp 过去）：
#   scp dist/quickshare-linux-armv7 root@router:/usr/bin/quickshare
#   scp deploy/quickshare.init     root@router:/etc/init.d/quickshare
#   scp deploy/quickshare.config   root@router:/etc/config/quickshare
#   ssh root@router 'chmod +x /etc/init.d/quickshare && /etc/init.d/quickshare enable'
#   ssh root@router '/etc/init.d/quickshare start'
#
# 改配置：编辑 /etc/config/quickshare，然后 `/etc/init.d/quickshare restart`。
# 看日志：`logread -e quickshare -f`（服务自己也往 stdout 打，procd 会收进 syslog）。
# 看状态：`/etc/init.d/quickshare status`。
#
# 架构别拿错：armv7 是给 bcm27xx / ipq40xx / mediatek 这类 ARM 路由器的，
# 老的 ath79 / ramips（MIPS）要用对应架构的产物——先 `uname -m` 看一眼。

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/quickshare
CONF=quickshare

start_service() {
	local enabled addr data token envs

	config_load "$CONF"
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get addr  main addr  ':8080'
	config_get data  main data  '/srv/quickshare'
	config_get token main token ''

	# 数据目录可能是刚配好的外置盘，先确保它在。
	# **一定要指到外置存储**：`/` 是 overlay，空间本来就小，几部电影就能把路由器写砖。
	mkdir -p "$data"

	# 口令走环境变量。没配就是空串，等于不鉴权（内网自用够用；
	# 只要这个端口有可能被公网碰到，就一定要配）。
	#
	# 其余 QS_* 变量在 UCI 里用 `list env 'KEY=value'` 追加，一行一个——
	# 所以这里先把要传的都攒进一个字符串，再一次性交给 procd。
	# **值里不能有空格**：下面靠分词摊平成参数，带空格的会被拆成两个。
	envs="QS_ADMIN_TOKEN=$token"
	collect_env() { envs="$envs $1"; }
	config_list_foreach main env collect_env

	procd_open_instance

	# `-data` 显式给：不给的话是相对工作目录的 `./data`，而 procd 的工作目录是 `/`，
	# 数据会落到 `/data` 里去。显式指定之后网页上的「文件存储位置」会变成只读——
	# 这是对的，位置该由部署方式决定。
	# `-tray=false`：托盘只在 Windows 上有效，这里只是把话说明白，Linux 上本来就是个空实现。
	procd_set_param command "$PROG" -addr "$addr" -data "$data" -tray=false

	# shellcheck disable=SC2086
	procd_set_param env $envs

	# 崩了就拉起来：3600 秒内最多重启 5 次，间隔 5 秒。
	# 有上限是故意的——配置写错时会一直起不来，无上限重启只会把日志刷满。
	procd_set_param respawn 3600 5 5

	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_close_instance
}

stop_service() {
	# procd 会按 pid 结束进程，这里不用自己 kill。
	:
}
