# QuickShare 的 OpenWrt 配置（UCI）。装到 /etc/config/quickshare
#
# 改完要 `/etc/init.d/quickshare restart` 才生效——procd 不会自动重读。

config quickshare 'main'
	# 总开关。设成 0 再 restart，服务会停住但开机仍会"启动"（什么都不做），
	# 想彻底不自启用 `/etc/init.d/quickshare disable`。
	option enabled '1'

	# 监听地址。`:8080` = 所有接口的 8080。
	# 只想让内网能访问就写死内网地址，比如 `192.168.1.1:8080`。
	option addr ':8080'

	# 数据目录。**指到外置存储**，别留在 overlay 上（`/` 空间很小，写满会出问题）。
	option data '/srv/quickshare'

	# 管理口令。留空 = 不鉴权（内网自用够用）。
	# 一旦这个端口有可能被公网碰到（端口转发、DMZ、把路由器挂到公网），就必须配。
	option token ''

	# 其余可调项都是环境变量，需要哪个加哪行（**值里不能有空格**）：
	#   list env 'QS_CHUNK_SIZE=4194304'     分片大小，默认 8 MiB
	#   list env 'QS_MAX_FILE_SIZE=0'        单文件上限，0 = 不限
	#   list env 'QS_UPLOAD_TTL_HOURS=24'    未完成分片保留多久
	#   list env 'QS_UPDATE_CHECK=0'         关掉更新检查（完全不出网的路由器）
	#
	# 路由器前面挂了反向代理（比如 LuCI 那台再套一层 Nginx）时，要把代理的地址写进
	# QS_TRUSTED_PROXIES，否则设备身份会变成代理自己、所有设备被合并成一台。
	# **不写 = 一个代理都不信**（服务不去读 X-Forwarded-For，这是唯一安全的值）。
	#   list env 'QS_TRUSTED_PROXIES=127.0.0.1'
