# QuickShare —— systemd 开机自启
#
# 装：
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin quickshare
#   sudo install -d -o quickshare -g quickshare /opt/quickshare /var/lib/quickshare
#   sudo install -m 755 dist/quickshare-linux-amd64 /opt/quickshare/quickshare
#   sudo install -m 644 deploy/quickshare.service /etc/systemd/system/quickshare.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now quickshare
#
# 下面三个路径按你实际的位置改：ExecStart、WorkingDirectory、ReadWritePaths。
# 改完 `sudo systemctl daemon-reload && sudo systemctl restart quickshare`。
#
# 看日志：`journalctl -u quickshare -f`（启动时会打印监听地址、数据目录、
# 有没有设口令——排查"为什么打不开"先看这三行）。

[Unit]
Description=QuickShare 内网文件分享
Documentation=https://github.com/shanhai2333/quickshare

# **不要只写 network.target。**
#
# 服务是"从连接推导设备身份"的（文本页按来源 IP 区分是谁发的），而推导要用本机网卡
# 地址表——开机自启时网卡可能还没拿到地址。程序里的地址表缓存会自愈（不是 sync.Once），
# 所以晚一点也能纠正回来；但**早到的那几个请求会被算成另一台设备**，文本页的设备列表
# 里就会多出一台，看着像 bug。多等这几秒，是为了让"第一次就是对的"。
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=quickshare
Group=quickshare
WorkingDirectory=/opt/quickshare

# **`-data` 必须显式给。**
#
# 不给的话数据目录是相对当前工作目录的 `./data`，而服务的工作目录由 systemd 决定，
# 换个启动方式数据就"不见了"。显式指定之后设置面板里的「文件存储位置」会变成只读
# （这是对的：位置由部署方式决定，不该在网页上改）。
ExecStart=/opt/quickshare/quickshare -addr :8080 -data /var/lib/quickshare

Restart=always
RestartSec=3

# 可选：把 QS_* 环境变量写在里面（QS_ADMIN_TOKEN / QS_CHUNK_SIZE / QS_UPDATE_CHECK…），
# 一行一个，`KEY=value`。前面的 `-` 表示文件不存在也不报错。
#EnvironmentFile=-/etc/quickshare.env

# 收紧权限：整个文件系统只读，只有数据目录可写。
# 服务本身不需要别的写权限——启动配置（`~/.config/quickshare/config.json`，只存
# "数据目录在哪"）在显式给了 `-data` 之后根本不会被写。
# 真遇到"某个目录写不了"，先注释掉这几行确认是不是这里卡的。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/quickshare

[Install]
WantedBy=multi-user.target
